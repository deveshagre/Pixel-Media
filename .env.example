# Pixel Media Client Portal — Environment Configuration
# Copy this file to .env and provide your Supabase project credentials.
# If these variables are left empty, the application runs in local persistent demo mode.

# Supabase Project URL (e.g., https://your-project.supabase.co)
VITE_SUPABASE_URL=

# Supabase Anonymous Public Key (starts with eyJ...)
# WARNING: NEVER expose service_role secret key in frontend applications.
VITE_SUPABASE_ANON_KEY=

# Application Base URL (optional, defaults to current origin)
VITE_APP_URL=http://localhost:5173
